# ============================================================
# TAMRAH – Supabase Environment Variables Configuration
# ============================================================
#
# IMPORTANT:
# 1. Copy this file to '.env' or '.env.local' in the root directory.
# 2. Fill in your project URL and public anon key from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys (anon / public).
# 3. NEVER put your service_role secret key or database password in this file.
# 4. Vite exposes all variables prefixed with 'VITE_' to the browser client bundle.
# ============================================================

# Your Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Public / Anon API Key (safe to use in client applications with Row Level Security enabled)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
