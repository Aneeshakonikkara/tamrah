# ============================================================
# TAMRAH — Production Environment Variables Configuration
# ============================================================
#
# INSTRUCTIONS FOR PRODUCTION:
# 1. Provide these environment variables in your hosting provider's dashboard
#    (e.g., Vercel -> Project Settings -> Environment Variables, or Cloudflare Pages).
# 2. NEVER put service_role keys, database connection strings with passwords,
#    or private auth tokens in frontend client variables.
# 3. Only variables prefixed with VITE_ are included in the compiled client bundle.
# ============================================================

# ── SUPABASE PRODUCTION CONFIGURATION ────────────────────────
# Your production Supabase project URL
VITE_SUPABASE_URL=https://your-production-ref.supabase.co

# Your production Supabase Anon / Public API Key
# (Safe for browser use because Row Level Security policies are active on PostgreSQL)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-production-anon-key

# ── BRAND & DOMAIN CONFIGURATION ─────────────────────────────
# Canonical production website URL
VITE_SITE_URL=https://tamrah.in

# Centralized Business WhatsApp contact (international format without + or spaces)
# Example: 919876543210 (India country code + 10-digit number)
VITE_WHATSAPP_PHONE=919876543210

# Business enquiry contact email
VITE_CONTACT_EMAIL=enquiries@tamrah.in
